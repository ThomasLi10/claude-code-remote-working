{
  "modules": ["./register.ts"],
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rw\" hook prompt-expansion 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rw\" hook session-end 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
